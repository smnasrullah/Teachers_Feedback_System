msgstr "প্রশ্নের বিভাগ"

msgid "Feedback rounds"
msgstr "মূল্যায়ন পর্ব"

msgid "Edit category"
msgstr "বিভাগ সম্পাদনা"

msgid "Back to categories"
msgstr "বিভাগের তালিকায় ফিরুন"

msgid "Add category"
msgstr "বিভাগ যোগ করুন"

msgid "Edit question"
msgstr "প্রশ্ন সম্পাদনা"

