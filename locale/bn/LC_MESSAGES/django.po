msgid "Enrollment"
msgstr "ভর্তি"

msgid "Enroll by level/term"
msgstr "লেভেল/টার্ম অনুযায়ী ভর্তি"

msgid "Enrollments"
msgstr "ভর্তিসমূহ"

msgid "Missing enrollment"
msgstr "ভর্তি বাকি"

msgid "Data"
msgstr "ডেটা"

msgid "CSV import"
msgstr "CSV ইম্পোর্ট"

msgid ""
"Download a template, fill it in, then upload it. You see a preview with "
"every row error before anything is saved, and a file is imported completely "
"or not at all."
msgstr ""
"একটি টেমপ্লেট ডাউনলোড করে পূরণ করুন, তারপর আপলোড করুন। কিছু সংরক্ষণের আগে "
"প্রতিটি সারির ত্রুটিসহ প্রিভিউ দেখানো হয়, এবং ফাইল হয় পুরোটা ইম্পোর্ট হয়,"
" নয়তো একেবারেই হয় না।"

msgid "Upload file"
msgstr "ফাইল আপলোড"

msgid "Download template"
msgstr "টেমপ্লেট ডাউনলোড"

msgid "Back to CSV import"
msgstr "CSV ইম্পোর্টে ফিরুন"

msgid "Import: %(what)s"
msgstr "ইম্পোর্ট: %(what)s"

msgid "Columns"
msgstr "কলাম"

msgid "Required:"
msgstr "আবশ্যক:"

msgid "Optional:"
msgstr "ঐচ্ছিক:"

msgid ""
"The header row must match exactly. Existing records are never changed: rows "
"that already exist are reported as errors. Cells that start with = + - or @ "
"lose that character."
msgstr ""
"হেডার সারি হুবহু মিলতে হবে। বিদ্যমান রেকর্ড কখনো বদলানো হয় না: যে সারি আগে "
"থেকেই আছে তা ত্রুটি হিসেবে দেখানো হয়। যে ঘর = + - বা @ দিয়ে শুরু হয়, সেই "
"চিহ্নটি বাদ যায়।"

msgid "Check file"
msgstr "ফাইল যাচাই"

msgid "Import preview"
msgstr "ইম্পোর্ট প্রিভিউ"

msgid "Preview: %(what)s"
msgstr "প্রিভিউ: %(what)s"

msgid "%(rows)s data rows were read. Nothing has been saved yet."
msgstr "%(rows)s টি ডেটা সারি পড়া হয়েছে। এখনো কিছু সংরক্ষিত হয়নি।"

msgid "%(count)s cells started with = + - or @; that character was removed."
msgstr ""
"%(count)s টি ঘর = + - বা @ দিয়ে শুরু হয়েছিল; সেই চিহ্ন বাদ দেওয়া হয়েছে।"

msgid "All rows are valid. Importing will create %(count)s records."
msgstr "সব সারি বৈধ। ইম্পোর্টে %(count)s টি রেকর্ড তৈরি হবে।"

msgid "Import now"
msgstr "এখনই ইম্পোর্ট করুন"

msgid ""
"%(count)s rows have errors. Fix the file and upload it again; nothing is "
"imported until every row is valid."
msgstr ""
"%(count)s টি সারিতে ত্রুটি আছে। ফাইল ঠিক করে আবার আপলোড করুন; প্রতিটি সারি "
"বৈধ না হওয়া পর্যন্ত কিছুই ইম্পোর্ট হবে না।"

msgid "Row errors"
msgstr "সারির ত্রুটি"

msgid "Line"
msgstr "লাইন"

msgid "Column"
msgstr "কলাম"

msgid "Problem"
msgstr "সমস্যা"

msgid "Showing the first %(shown)s of %(total)s errors."
msgstr "%(total)s টি ত্রুটির প্রথম %(shown)s টি দেখানো হচ্ছে।"

msgid "Upload another file"
msgstr "আরেকটি ফাইল আপলোড করুন"

msgid ""
"Change the teacher of several offerings, then save this page. Only the "
"offerings shown here are saved."
msgstr ""
"একাধিক অফারিংয়ের শিক্ষক বদলে এই পাতা সংরক্ষণ করুন। শুধু এখানে দেখানো "
"অফারিংগুলো সংরক্ষিত হয়।"

msgid "Filter offerings"
msgstr "অফারিং ফিল্টার করুন"

msgid "Offerings of %(name)s"
msgstr "%(name)s-এর অফারিং"

msgid "Teacher for %(course)s"
msgstr "%(course)s-এর শিক্ষক"

msgid "Save assignments"
msgstr "নিয়োগ সংরক্ষণ"

msgid "No offerings"
msgstr "কোনো অফারিং নেই"

msgid "Add course offerings or change the filters."
msgstr "কোর্স অফারিং যোগ করুন, অথবা ফিল্টার বদলান।"

msgid ""
"Enrolls every active student of a program at a level/term in all compulsory "
"offerings of that program and level/term in the current semester. Electives "
"are enrolled one student at a time. Offerings with a section take only "
"students of that section."
msgstr ""
"বর্তমান সেমিস্টারে কোনো প্রোগ্রামের নির্দিষ্ট লেভেল/টার্মের প্রতিটি সক্রিয় "
"শিক্ষার্থীকে সেই প্রোগ্রাম ও লেভেল/টার্মের সব আবশ্যিক অফারিংয়ে ভর্তি করে। "
"ঐচ্ছিক কোর্সে একজন একজন করে ভর্তি করতে হয়। সেকশনযুক্ত অফারিংয়ে শুধু সেই "
"সেকশনের শিক্ষার্থীরা ভর্তি হয়।"

msgid "Preview"
msgstr "প্রিভিউ"

msgid ""
"%(students)s students × %(offerings)s offerings: %(new)s new enrollments "
"will be created. Existing enrollments are left as they are."
msgstr ""
"%(students)s জন শিক্ষার্থী × %(offerings)s টি অফারিং: %(new)s টি নতুন ভর্তি "
"তৈরি হবে। বিদ্যমান ভর্তি যেমন আছে তেমনই থাকবে।"

msgid "Enroll now"
msgstr "এখনই ভর্তি করুন"

msgid "Enroll one student"
msgstr "একজন শিক্ষার্থীকে ভর্তি করুন"

msgid "Enroll"
msgstr "ভর্তি করুন"

msgid "Filter enrollments"
msgstr "ভর্তি ফিল্টার করুন"

msgid "Remove"
msgstr "সরান"

msgid "No enrollments"
msgstr "কোনো ভর্তি নেই"

msgid "Enroll students, or change the filters."
msgstr "শিক্ষার্থীদের ভর্তি করুন, অথবা ফিল্টার বদলান।"

msgid "Remove enrollment"
msgstr "ভর্তি বাতিল"

msgid ""
"Remove student %(student)s from %(course)s? The student will no longer see "
"this course."
msgstr ""
"শিক্ষার্থী %(student)s-কে %(course)s থেকে সরাবেন? শিক্ষার্থী আর এই কোর্স "
"দেখতে পাবে না।"

msgid "Students missing enrollment"
msgstr "ভর্তি বাকি শিক্ষার্থী"

msgid "Active students with no enrollment in the current semester."
msgstr "বর্তমান সেমিস্টারে কোনো ভর্তি নেই এমন সক্রিয় শিক্ষার্থী।"

msgid "Filter students"
msgstr "শিক্ষার্থী ফিল্টার করুন"

msgid "Everyone is enrolled"
msgstr "সবাই ভর্তি আছে"

msgid "No active student is missing an enrollment."
msgstr "কোনো সক্রিয় শিক্ষার্থীর ভর্তি বাকি নেই।"

msgid "%(count)d record was imported."
msgid_plural "%(count)d records were imported."
msgstr[0] "%(count)d টি রেকর্ড ইম্পোর্ট করা হয়েছে।"
msgstr[1] "%(count)d টি রেকর্ড ইম্পোর্ট করা হয়েছে।"

msgid "%(count)d assignment was changed."
msgid_plural "%(count)d assignments were changed."
msgstr[0] "%(count)d টি নিয়োগ বদলানো হয়েছে।"
msgstr[1] "%(count)d টি নিয়োগ বদলানো হয়েছে।"

msgid "%(count)d enrollment was created."
msgid_plural "%(count)d enrollments were created."
msgstr[0] "%(count)d টি ভর্তি তৈরি হয়েছে।"
msgstr[1] "%(count)d টি ভর্তি তৈরি হয়েছে।"
