"এই সংস্করণটি নতুন সংস্করণ দিয়ে প্রতিস্থাপিত হয়েছে, তাই সক্রিয় করা যাবে "
"না।"

msgid "Expected %(want)d columns, found %(got)d."
msgstr "%(want)d টি কলাম প্রত্যাশিত, পাওয়া গেছে %(got)d টি।"

msgid "No question text."
msgstr "প্রশ্নের লেখা নেই।"

msgid "No category."
msgstr "বিভাগ নেই।"

msgid "Unknown type %(value)r."
msgstr "অজানা ধরন %(value)r।"

msgid "Required must be yes or no."
msgstr "আবশ্যক ঘরে yes বা no লিখতে হবে।"

msgid "Unknown applies value %(value)r."
msgstr "প্রযোজ্যতার অজানা মান %(value)r।"

msgid "A choice question needs at least two options."
msgstr "পছন্দভিত্তিক প্রশ্নে অন্তত দুটি বিকল্প দরকার।"

msgid "English and Bangla options differ in number."
msgstr "ইংরেজি ও বাংলা বিকল্পের সংখ্যা আলাদা।"

msgid "Empty row."
msgstr "ফাঁকা সারি।"

msgid "This round overlaps with %(names)s for the same courses."
msgstr "এই পর্বটি একই কোর্সের জন্য %(names)s পর্বের সঙ্গে সময়ে মিলে যায়।"

msgid "Load the question bank from a markdown file (safe to run again)."
msgstr "মার্কডাউন ফাইল থেকে প্রশ্নভান্ডার লোড করুন (আবার চালানো নিরাপদ)।"

msgid "Cannot read %(path)s: %(error)s"
msgstr "%(path)s পড়া যায়নি: %(error)s"

msgid ""
"Questions: %(created)d created, %(updated)d updated, %(unchanged)d "
"unchanged; %(categories)d new categories; %(placeholders)d placeholders."
msgstr ""
"প্রশ্ন: %(created)d টি নতুন, %(updated)d টি হালনাগাদ, %(unchanged)d টি "
"অপরিবর্তিত; %(categories)d টি নতুন বিভাগ; %(placeholders)d টি নমুনা প্রশ্ন।"

msgid "Skipped line %(line)d: %(reason)s"
msgstr "লাইন %(line)d বাদ দেওয়া হয়েছে: %(reason)s"

