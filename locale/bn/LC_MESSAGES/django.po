msgid "Re-encrypt all encrypted columns with the first key in FIELD_ENCRYPTION_KEYS. Prepend the new key, run this, then remove the old key."
msgstr "FIELD_ENCRYPTION_KEYS-এর প্রথম কী দিয়ে সব এনক্রিপ্ট করা কলাম পুনরায় এনক্রিপ্ট করে। নতুন কী তালিকার শুরুতে যোগ করুন, এটি চালান, তারপর পুরোনো কী সরান।"

msgid "%(label)s: %(count)d rows re-encrypted"
