msgstr "ফাইলটি অনেক বড়। সীমা %(mb)d এমবি।"

msgid "The file must be saved as UTF-8 (in Excel: “CSV UTF-8”)."
msgstr "ফাইলটি UTF-8 হিসেবে সংরক্ষণ করতে হবে (এক্সেলে: “CSV UTF-8”)।"

msgid "The file is not a text CSV file."
msgstr "ফাইলটি টেক্সট CSV ফাইল নয়।"

msgid "missing: %(names)s"
msgstr "নেই: %(names)s"

msgid "not allowed: %(names)s"
msgstr "অনুমোদিত নয়: %(names)s"

msgid "repeated: %(names)s"
msgstr "পুনরাবৃত্ত: %(names)s"

msgid "The header row does not match the template (%(problems)s)."
msgstr "হেডার সারি টেমপ্লেটের সাথে মেলে না (%(problems)s)।"

msgid "The file is empty."
msgstr "ফাইলটি খালি।"

msgid "The file has more than %(max)d rows."
msgstr "ফাইলে %(max)d-এর বেশি সারি আছে।"

msgid "The row has more cells than the header."
msgstr "সারিতে হেডারের চেয়ে বেশি ঘর আছে।"

msgid "The file is not a valid CSV file."
msgstr "ফাইলটি বৈধ CSV ফাইল নয়।"

msgid ""
"The data changed while the file was being imported. Nothing was saved; try "
"again."
msgstr ""
"ফাইল ইম্পোর্টের সময় ডেটা বদলে গেছে। কিছুই সংরক্ষিত হয়নি; আবার চেষ্টা করুন।"

msgid "There is no current semester."
msgstr "বর্তমান কোনো সেমিস্টার নেই।"

msgid "student"
msgstr "শিক্ষার্থী"

msgid "enrollment"
msgstr "ভর্তি"

msgid "enrollments"
msgstr "ভর্তি"

msgid "Regular"
msgstr "নিয়মিত"

msgid "Retake"
msgstr "রিটেক"

