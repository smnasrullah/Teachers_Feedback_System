# Production settings for docker-compose.prod.yml. On the server: copy to .env, fill every
# "change-me", keep it private (chmod 600). Never commit .env. Guide: docs/DEPLOY.md.
# The app refuses to start while any secret below is missing, weak, or still "change-me".

# --- Site address -------------------------------------------------------------------------
# Your domain (its DNS A record must point at this server). Allowed host, CSRF origin and the
# address in e-mails are all made from it: https://<DOMAIN>.
DOMAIN=feedback.example.edu
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=change-me@example.edu

# --- Secrets (generate each one separately; see docs/DEPLOY.md step 7) -----------------------
# Django signing key, 50+ random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
# Fernet key(s) for encrypted columns, comma-separated: the FIRST encrypts, all decrypt.
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# LOSING THESE KEYS MAKES ENCRYPTED DATA UNRECOVERABLE. Back them up apart from the database.
FIELD_ENCRYPTION_KEYS=change-me
# HMAC key for blind indexes (32+ chars, different from every key above). Also back it up:
# changing or losing it breaks every look-up by student ID.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BLIND_INDEX_KEY=change-me

# --- PostgreSQL ---------------------------------------------------------------------------
# Database name and user created on first start.
POSTGRES_DB=tfs
POSTGRES_USER=tfs
# 16+ random characters, letters and digits only (it goes inside a URL):
#   python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=change-me

# --- Set by docker-compose.prod.yml (leave out; listed so every variable is documented) -----
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_ALLOWED_HOSTS=<DOMAIN>
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<DOMAIN>
# SITE_URL=https://<DOMAIN>
# DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
# CACHE_URL=redis://redis:6379/2
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
# MEDIA_ROOT=/app/media
# TRUSTED_PROXY_COUNT=1   (Caddy is the one proxy; a wrong value lets clients fake their IP)
# RUN_MIGRATIONS=1        (web container only)
# DJANGO_READ_ENV_FILE=false   (set in the image: the environment comes from compose)
# DJANGO_DEBUG=false      (ignored: production settings never run in debug mode)

# --- App server ---------------------------------------------------------------------------
# Gunicorn worker processes (about 2 x CPU cores + 1) and request timeout in seconds.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
# Seconds a database connection is reused.
DB_CONN_MAX_AGE=60

# --- Sign-in and sessions -----------------------------------------------------------------
# Signed out after this many seconds idle / this many seconds in total.
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
# Failed sign-ins per username and address before a cool-off of this many minutes.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# --- Notification e-mail (reminders, result notices; never used to sign in) ---------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=change-me.smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Teacher Feedback System <no-reply@example.edu>
# Text messages need a gateway; keep false until one is configured.
NOTIFICATION_SMS_ENABLED=false

# --- Logging ------------------------------------------------------------------------------
# Level (DEBUG, INFO, WARNING, ERROR) and JSON lines (true suits `docker compose logs`).
LOG_LEVEL=INFO
LOG_JSON=true

# --- Feedback rules (first values; the Admin's System settings page wins once saved) -------
# Results and comment lists stay hidden below this many responses (never below 3).
MIN_RESPONSES=5
# "after_close" (results once a round closes) or "held" (not until the Admin releases them).
RESULTS_VISIBLE=after_close
# Unfinished drafts are deleted this many days after the last save.
DRAFT_RETENTION_DAYS=30
# Hours before a round closes when students with open forms are reminded.
REMINDER_HOURS_BEFORE_CLOSE=72,24,1
# Tell students the moment a round opens.
REMINDER_ON_OPEN=true
# E-mail and texts wait from this hour until that hour (Asia/Dhaka, 0-23).
QUIET_HOURS_START=22
QUIET_HOURS_END=7
# A course average below this raises an alert for the head of department.
LOW_RATING_THRESHOLD=3.5
# Show students their own student ID on their pages.
SHOW_OWN_ID_TO_STUDENT=false

# --- Comment filter -----------------------------------------------------------------------
# "remove" abusive words or "mask" them with asterisks.
PROFANITY_ACTION=remove
# Optional AI check of comment text (personal details removed first; failures fall back to
# the word lists). Needs an Anthropic API key.
FILTER_AI_ENABLED=false
ANTHROPIC_API_KEY=
FILTER_AI_MODEL=claude-haiku-5-5
FILTER_AI_TIMEOUT=3
