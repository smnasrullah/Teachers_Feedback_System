# Copy to .env (never commit .env). All values below are read by config/settings/*.py.

# Settings module: config.settings.dev (local) or config.settings.prod (production).
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required. Long random string; generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me

# Enables debug pages. Always false in production. (dev settings force it on)
DJANGO_DEBUG=true

# Comma-separated host names the site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (scheme included) trusted for CSRF, e.g. https://feedback.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=

# Required. Comma-separated Fernet keys for encrypted columns; the FIRST encrypts, all decrypt.
# Rotate: prepend a new key, run `python manage.py rotate_encryption_keys`, then drop the old one.
# Back these up: losing every key makes encrypted data unreadable. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=change-me

# Required. HMAC key (>= 32 chars) for blind indexes; must differ from the keys above and
# DJANGO_SECRET_KEY. Changing it invalidates every stored index. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BLIND_INDEX_KEY=change-me

# Session lifetime in seconds: signed out after this much inactivity / after this long in total.
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200

# Number of reverse proxies in front of the app that append to X-Forwarded-For
# (prod default 1, dev default 0). Wrong values let clients spoof their IP.
TRUSTED_PROXY_COUNT=0

# Login lockout (django-axes): failures per username+IP before a cool-off of N minutes.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# One-time codes: production sends e-mail through this SMTP server. SMS has no gateway yet, so keep
# OTP_SMS_ENABLED=false (sign-up and recovery then use e-mail only). Dev prints codes to the console.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Teacher Feedback System <no-reply@example.edu>
OTP_SMS_ENABLED=false

# Logging: level, and JSON lines (prod default true, dev default false).
LOG_LEVEL=INFO
LOG_JSON=false

# Redirect HTTP to HTTPS (prod only). Set false only behind a TLS-terminating proxy that does it.
DJANGO_SECURE_SSL_REDIRECT=true

# Database URL. Empty = local SQLite file (quick local runs only; PostgreSQL for real use).
DATABASE_URL=postgres://tfs:tfs@localhost:5432/tfs

# Where uploaded images (avatars, teacher photos) are stored. Default: <project>/media.
# MEDIA_ROOT=

# Cache URL. Redis in production (also used for rate limiting); locmem for quick local runs.
CACHE_URL=locmemcache://tfs

# Celery broker and result backend (Redis). Dev settings run tasks eagerly, so no worker is needed.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# docker compose only: PostgreSQL credentials for the `db` service.
POSTGRES_DB=tfs
POSTGRES_USER=tfs
POSTGRES_PASSWORD=change-me

# Comment filter: "remove" abusive words (default) or "mask" them with asterisks.
# PROFANITY_ACTION=remove
# Optional AI check of comments. Needs an Anthropic API key; any failure falls back to the word lists.
# FILTER_AI_ENABLED=false
# ANTHROPIC_API_KEY=
# FILTER_AI_MODEL=claude-haiku-5-5
# FILTER_AI_TIMEOUT=3
