# Copy to .env (never commit .env). All values below are read by config/settings/*.py.

# Settings module: config.settings.dev (local) or config.settings.prod (production).
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required. Long random string; generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me

# Enables debug pages. Always false in production. (dev settings force it on)
DJANGO_DEBUG=true

# Comma-separated host names the site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (scheme included) trusted for CSRF, e.g. https://feedback.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=

# Redirect HTTP to HTTPS (prod only). Set false only behind a TLS-terminating proxy that does it.
DJANGO_SECURE_SSL_REDIRECT=true

# Database URL. Empty = local SQLite file (quick local runs only; PostgreSQL for real use).
DATABASE_URL=postgres://tfs:tfs@localhost:5432/tfs

# Cache URL. Redis in production (also used for rate limiting); locmem for quick local runs.
CACHE_URL=locmemcache://tfs

# Celery broker and result backend (Redis). Dev settings run tasks eagerly, so no worker is needed.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# docker compose only: PostgreSQL credentials for the `db` service.
POSTGRES_DB=tfs
POSTGRES_USER=tfs
POSTGRES_PASSWORD=change-me
